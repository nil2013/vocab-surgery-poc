+def ple_token_ids(model_dir: Path, vocab: int) -> tuple[int, np.ndarray | None]:
+    """A vocabulary-pruned checkpoint's ple-token-ids.json: PLE's training-time vocabulary size and each row's token id."""
+
+    path = model_dir / "ple-token-ids.json"
+    if not path.exists():
+        return 0, None
+    table = json.loads(path.read_text())
+    ids, size = np.asarray(table["originalTokenIds"], dtype=np.int64), int(table["originalVocabSize"])
+    if ids.shape != (vocab,) or (ids.size and (ids[0] < 0 or ids[-1] >= size or np.any(np.diff(ids) <= 0))):
+        raise ValueError(f"{path}: expected {vocab} increasing token ids below {size}")
+    return size, ids
+
