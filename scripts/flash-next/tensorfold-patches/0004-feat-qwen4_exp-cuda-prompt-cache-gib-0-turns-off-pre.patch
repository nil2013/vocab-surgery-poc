From 3f3f93415680ebfe3429df2dd4d46f0aefa05f8f Mon Sep 17 00:00:00 2001
From: Nil <lue.gsk.2012@gmail.com>
Date: Wed, 7 Oct 2026 13:10:02 +0900
Subject: [PATCH] feat(qwen4_exp cuda): --prompt-cache-gib 0 turns off prefix
 reuse

The CUDA engine always resumed a prompt from a kept prefix, so repeated
prompts reported cached tokens and skipped part of their prefill. A
controlled before/after comparison needs every prompt prefilled whole:
with --prompt-cache-gib 0 (the MLX servers' "off") the serial engine keeps
and resumes no prefix. It serves one stream.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011XiGQHTjzpMVa5sTqiQmg5
---
 src/tensorfold/cli.py                            |  3 +++
 src/tensorfold/families/qwen4_exp/__init__.py    |  8 ++++++--
 src/tensorfold/families/qwen4_exp/cuda/engine.py |  8 +++++++-
 tests/test_flashnext_ple_token_ids.py            | 12 ++++++++++++
 4 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/src/tensorfold/cli.py b/src/tensorfold/cli.py
index 541bdd7..d75177f 100644
--- a/src/tensorfold/cli.py
+++ b/src/tensorfold/cli.py
@@ -4,6 +4,7 @@ from __future__ import annotations
 
 import argparse
 import functools
+import inspect
 import json
 import os
 from pathlib import Path
@@ -262,6 +263,8 @@ def _serve_cuda(args: argparse.Namespace, family: Any, model_dir: Path, context:
         options["mtp_confidence"] = float(args.mtp_confidence)
     if getattr(args, "draft_vocab", None):
         options["draft_vocab"] = str(Path(args.draft_vocab).resolve())
+    if getattr(args, "prompt_cache_gib", None) is not None and "prompt_cache_gib" in inspect.signature(family.package.cuda_engine).parameters:
+        options["prompt_cache_gib"] = float(args.prompt_cache_gib)
     if getattr(args, "decode_share", None) is not None:
         options["decode_share"] = float(args.decode_share)
     options["context"] = context if context is not None else args.context
diff --git a/src/tensorfold/families/qwen4_exp/__init__.py b/src/tensorfold/families/qwen4_exp/__init__.py
index 1d88c93..e956632 100644
--- a/src/tensorfold/families/qwen4_exp/__init__.py
+++ b/src/tensorfold/families/qwen4_exp/__init__.py
@@ -171,9 +171,10 @@ def cuda_engine(model_dir: str | Path, *, drafter: str = "", tp: int = 1, rank:
                 master_port: int = 29551, no_drafts: bool = False, mtp_drafts: int | None = None,
                 mtp_confidence: float | None = None, context: int | None = None, ple_on_ssd: bool = False,
                 kv_dtype: str = "bf16", decode_share: float | None = None, draft_vocab: str | None = None,
-                **options: Any):
+                prompt_cache_gib: float | None = None, **options: Any):
     """Verify MTP on one or two CUDA GPUs; start rank 1 first for ``tp=2``, with bf16, int8 or int4 KV storage.
-    ``draft_vocab`` is a file of upstream token ids replacing the built-in draft list."""
+    ``draft_vocab`` is a file of upstream token ids replacing the built-in draft list; ``prompt_cache_gib`` 0 turns off
+    reusing a kept prompt prefix, so every prompt is prefilled whole (one stream only)."""
 
     from tensorfold.cuda import build
     from tensorfold.cuda.exl3.format import is_exl3
@@ -196,7 +197,10 @@ def cuda_engine(model_dir: str | Path, *, drafter: str = "", tp: int = 1, rank:
                          "has one): without it every round would decode one token. Serve a checkpoint with the "
                          "head, or pass --no-drafts for the serial reference")
     confidence = CONFIDENCE if mtp_confidence is None else float(mtp_confidence)
+    if prompt_cache_gib == 0 and int(options.get("parallel") or 1) > 1:
+        raise ValueError("--prompt-cache-gib 0 serves one stream; drop --parallel")
     return FlashNextEngine(Path(model_dir), depth=depth, confidence=confidence, draft_vocab=draft_vocab or "default",
+                           prompt_cache=prompt_cache_gib != 0,
                            max_len=context,
                            context_explicit=options.get("context_explicit"), tp=int(tp), rank=int(rank),
                            master=master, port=int(master_port), streams=max(1, int(options.get("parallel") or 1)),
diff --git a/src/tensorfold/families/qwen4_exp/cuda/engine.py b/src/tensorfold/families/qwen4_exp/cuda/engine.py
index 002ff1f..e4efa85 100644
--- a/src/tensorfold/families/qwen4_exp/cuda/engine.py
+++ b/src/tensorfold/families/qwen4_exp/cuda/engine.py
@@ -61,7 +61,8 @@ class FlashNextEngine:
                  draft_vocab: str | int | None = "default", max_len: int | None = None,
                  context_explicit: bool | None = None, tp: int = 1, rank: int = 0, master: str = "", port: int = 29551,
                  prefetch: bool = True, graphs: bool = True, streams: int = 1, ple_on_ssd: bool = False,
-                 kv_dtype: str = "bf16", share: float = 0.0, vision: bool = False, vision_urls: bool = False) -> None:
+                 kv_dtype: str = "bf16", share: float = 0.0, vision: bool = False, vision_urls: bool = False,
+                 prompt_cache: bool = True) -> None:
         import torch
 
         from .exl3_pack import admission, extra_files, is_exl3
@@ -242,6 +243,7 @@ class FlashNextEngine:
         self.eos = tuple(w.cfg.eos)
         self.model_dir = Path(model_dir)
         self.served = 0
+        self.prompt_cache = bool(prompt_cache)           # False: every prompt is prefilled whole (controlled comparisons)
         self.cache: list[tuple[list[int], dict]] = []    # (committed ids, what resuming from them needs)
         self.serial = None                                # the serial requests' engine, made on first use
         rule = (f"1 to {self.depth} MTP drafts a round, a chain stops before a later draft under "
@@ -356,6 +358,8 @@ class FlashNextEngine:
         """The longest kept state the prompt extends (with at least one new token), or None."""
 
         best = None
+        if not self.prompt_cache:
+            return None
         for ids, snap in self.cache:
             if len(ids) < len(prompt) and prompt[:len(ids)] == ids and (best is None or len(ids) > len(best[0])):
                 best = (ids, snap)
@@ -371,6 +375,8 @@ class FlashNextEngine:
             self.cache = [c for c in self.cache if len(c[0]) < n and hit[0][:len(c[0])] == c[0]] + [hit]
 
     def _remember(self, ids: list[int], snap: dict) -> None:
+        if not self.prompt_cache:
+            return
         self.cache = [c for c in self.cache if c[0] != ids][-(KEEP_SERIAL - 1):] + [(ids, snap)]
 
     @property
diff --git a/tests/test_flashnext_ple_token_ids.py b/tests/test_flashnext_ple_token_ids.py
index 2210d52..78c1e69 100644
--- a/tests/test_flashnext_ple_token_ids.py
+++ b/tests/test_flashnext_ple_token_ids.py
@@ -60,3 +60,15 @@ def test_a_draft_list_file_maps_like_the_builtin_one(tmp_path):
     assert draft_rows(str(listed), None).tolist() == [0, 1, 4, 9, 11]
     assert draft_rows(3, kept).tolist() == [0, 1, 2]
     assert draft_rows(None, kept) is None
+
+
+def test_prompt_cache_off_keeps_no_prefix():
+    from tensorfold.families.qwen4_exp.cuda.engine import FlashNextEngine
+    engine = FlashNextEngine.__new__(FlashNextEngine)
+    engine.prompt_cache, engine.cache = False, []
+    engine._remember([1, 2], {"state": 0})
+    assert engine.cache == [] and engine._resume([1, 2, 3]) is None
+    engine.prompt_cache = True
+    engine._remember([1, 2], {"state": 0})
+    assert engine._resume([1, 2, 3])[0] == [1, 2]
+
