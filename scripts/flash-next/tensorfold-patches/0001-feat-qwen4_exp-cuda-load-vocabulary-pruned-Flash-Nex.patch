+"""A vocabulary-pruned Flash Next checkpoint hashes its n-grams with the token ids PLE was trained on."""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pytest
+
+from tensorfold.families.qwen4_exp.cuda.weight_types import Config, ple_token_ids
+
+
+def _write(tmp_path, vocab, eos, table=None):
+    text = {"hidden_size": 8, "num_hidden_layers": 1, "layer_types": ["full_attention"], "vocab_size": vocab,
+            "rms_norm_eps": 1e-6, "num_attention_heads": 2, "num_key_value_heads": 1, "head_dim": 4,
+            "linear_num_key_heads": 1, "linear_num_value_heads": 1, "linear_key_head_dim": 4, "linear_value_head_dim": 4,
+            "linear_conv_kernel_dim": 4, "num_experts": 2, "num_experts_per_tok": 1, "moe_intermediate_size": 4,
+            "shared_expert_intermediate_size": 4, "eos_token_id": eos, "ple_layer_ids": [1], "ple_embed_dim": 8}
+    (tmp_path / "config.json").write_text(json.dumps({"text_config": text, "eos_token_id": [eos]}))
+    if table is not None:
+        (tmp_path / "ple-token-ids.json").write_text(json.dumps(table))
+
+
+def test_pruned_rows_hash_like_their_upstream_ids(tmp_path):
+    upstream = tmp_path / "upstream"
+    pruned = tmp_path / "pruned"
+    upstream.mkdir()
+    pruned.mkdir()
+    kept = [0, 3, 4, 7, 9]
+    _write(upstream, 12, 9)
+    _write(pruned, len(kept), 4, {"originalVocabSize": 12, "originalTokenIds": kept})
+    a, b = Config.read(upstream), Config.read(pruned)
+    assert (b.vocab, b.ple_vocab, b.ple_eos, b.eos) == (5, 12, 9, (4,))
+    assert np.array_equal(a.ngram().multipliers, b.ngram().multipliers)
+    compact = np.array([1, 2, 4, 3, 0])
+    up, down = a.ngram(), b.ngram()
+    assert np.array_equal(down.canonical(compact), np.array(kept)[compact])
+    assert np.array_equal(down.ids(down.initial_history(), down.canonical(compact)),
+                          up.ids(up.initial_history(), np.array(kept)[compact]))
+    assert np.array_equal(up.canonical(compact), compact)
+
+
+def test_table_must_match_the_rows(tmp_path):
+    (tmp_path / "ple-token-ids.json").write_text(json.dumps({"originalVocabSize": 4, "originalTokenIds": [0, 2, 1]}))
+    with pytest.raises(ValueError):
+        ple_token_ids(tmp_path, 3)
+    assert ple_token_ids(tmp_path / "absent", 3) == (0, None)
