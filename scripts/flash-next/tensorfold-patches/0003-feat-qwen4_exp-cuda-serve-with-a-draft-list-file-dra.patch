+
+
+def test_a_draft_list_file_maps_like_the_builtin_one(tmp_path):
+    kept = np.array([0, 3, 4, 7, 9])
+    listed = tmp_path / "draft.txt"
+    listed.write_text("9\n1\n4\n0\n11\n")
+    assert draft_rows(str(listed), kept).tolist() == [0, 2, 4]
+    assert draft_rows(str(listed), None).tolist() == [0, 1, 4, 9, 11]
+    assert draft_rows(3, kept).tolist() == [0, 1, 2]
+    assert draft_rows(None, kept) is None
