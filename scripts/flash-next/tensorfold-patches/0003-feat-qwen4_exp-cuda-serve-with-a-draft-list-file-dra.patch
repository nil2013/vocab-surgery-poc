         draft_head, draft_ids = None, None
-        ids = draft_token_ids(draft_vocab)
-        if ids is not None and draft_vocab == "default" and full.ple_token_ids is not None:
-            ids = pruned_draft_ids(ids, full.ple_token_ids)
+        ids = draft_rows(draft_vocab, full.ple_token_ids)
         if ids is not None:
             ids = np.array_split(ids[ids < full.vocab], world)[rank]
